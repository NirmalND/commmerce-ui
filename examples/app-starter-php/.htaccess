# Apache: send every request to index.php, and pass the Authorization header through
# (Apache drops it for PHP by default, and the session token travels in it).
CGIPassAuth On
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteCond %{REQUEST_URI} !^/index\.php$
RewriteRule ^ index.php [L]
# Never serve the library, tests or downloaded files directly.
RedirectMatch 404 ^/(lib|tests|public)/
